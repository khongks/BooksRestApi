

CREATE COMPUTE MODULE listBooks_Compute
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		
		
-- Keep the Transport headers (HTTP, etc.)
		SET OutputRoot.Properties = InputRoot.Properties;
		
		-- Create the JSON response array
		CREATE FIELD OutputRoot.JSON.Data IDENTITY (JSON.Array)Data;
		DECLARE list REFERENCE TO OutputRoot.JSON.Data;
				
				
		-- Populate 10 "real" sample books with Titles
		
		-- Book 1
		SET list.Item[1].id = 1;
		SET list.Item[1].title = 'The Great Gatsby';
		SET list.Item[1].isbn = '978-0743273565';
		SET list.Item[1].author = 'F. Scott Fitzgerald';
		SET list.Item[1].published = '1925-04-10';
		SET list.Item[1].format = 'Hardcover';
		SET list.Item[1].language = 'English';
		SET list.Item[1].pages = 180;
		
