

CREATE COMPUTE MODULE listBooks_Compute
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		
		
-- Keep the Transport headers (HTTP, etc.)
		SET OutputRoot.Properties = InputRoot.Properties;
		
		-- Create the JSON response array
		CREATE FIELD OutputRoot.JSON.Data IDENTITY (JSON.Array)Data;
		DECLARE refBook REFERENCE TO OutputRoot.JSON.Data.Item;
				
		-- Populate 10 "real" sample books
		
		-- Book 1
		CREATE LASTCHILD OF OutputRoot.JSON.Data.Item AS refBook TYPE NameValue NAME 'Item';
		SET refBook.id = 1;
		SET refBook.title = 'The Great Gatsby';
		SET refBook.isbn = '978-0743273565';
		SET refBook.author = 'F. Scott Fitzgerald';
		SET refBook.published = '1925-04-10';
		SET refBook.format = 'Hardcover';
		SET refBook.language = 'English';
		SET refBook.pages = 180;
		
		-- Book 2
		CREATE LASTCHILD OF OutputRoot.JSON.Data.Item AS refBook TYPE NameValue NAME 'Item';
		SET refBook.id = 2;
		SET refBook.title = '1984';
		SET refBook.isbn = '978-0451524935';
		SET refBook.author = 'George Orwell';
		SET refBook.published = '1949-06-08';
		SET refBook.format = 'Paperback';
		SET refBook.language = 'English';
		SET refBook.pages = 328;
		
		-- Book 3
		CREATE LASTCHILD OF OutputRoot.JSON.Data.Item AS refBook TYPE NameValue NAME 'Item';
		SET refBook.id = 3;
		SET refBook.title = 'To Kill a Mockingbird';
		SET refBook.isbn = '978-0061120084';
		SET refBook.author = 'Harper Lee';
		SET refBook.published = '1960-07-11';
		SET refBook.format = 'Hardcover';
		SET refBook.language = 'English';
		SET refBook.pages = 281;
		
		-- Book 4
		CREATE LASTCHILD OF OutputRoot.JSON.Data.Item AS refBook TYPE NameValue NAME 'Item';
		SET refBook.id = 4;
		SET refBook.title = 'Pride and Prejudice';
		SET refBook.isbn = '978-0141439518';
		SET refBook.author = 'Jane Austen';
		SET refBook.published = '1813-01-28';
		SET refBook.format = 'Paperback';
		SET refBook.language = 'English';
		SET refBook.pages = 432;
		
		-- Book 5
		CREATE LASTCHILD OF OutputRoot.JSON.Data.Item AS refBook TYPE NameValue NAME 'Item';
		SET refBook.id = 5;
		SET refBook.title = 'The Catcher in the Rye';
		SET refBook.isbn = '978-0316769488';
		SET refBook.author = 'J.D. Salinger';
		SET refBook.published = '1951-07-16';
		SET refBook.format = 'Hardcover';
		SET refBook.language = 'English';
		SET refBook.pages = 234;
		
		-- Book 6
		CREATE LASTCHILD OF OutputRoot.JSON.Data.Item AS refBook TYPE NameValue NAME 'Item';
		SET refBook.id = 6;
		SET refBook.title = 'The Hobbit';
		SET refBook.isbn = '978-0544003415';
		SET refBook.author = 'J.R.R. Tolkien';
		SET refBook.published = '1937-09-21';
		SET refBook.format = 'Paperback';
		SET refBook.language = 'English';
		SET refBook.pages = 310;
		
		-- Book 7
		CREATE LASTCHILD OF OutputRoot.JSON.Data.Item AS refBook TYPE NameValue NAME 'Item';
		SET refBook.id = 7;
		SET refBook.title = 'The Fellowship of the Ring';
		SET refBook.isbn = '978-0345339706';
		SET refBook.author = 'J.R.R. Tolkien';
		SET refBook.published = '1954-07-29';
		SET refBook.format = 'Hardcover';
		SET refBook.language = 'English';
		SET refBook.pages = 423;
		
		-- Book 8
		CREATE LASTCHILD OF OutputRoot.JSON.Data.Item AS refBook TYPE NameValue NAME 'Item';
		SET refBook.id = 8;
		SET refBook.title = 'One Hundred Years of Solitude';
		SET refBook.isbn = '978-0143039433';
		SET refBook.author = 'Gabriel García Márquez';
		SET refBook.published = '1967-05-30';
		SET refBook.format = 'Paperback';
		SET refBook.language = 'Spanish';
		SET refBook.pages = 417;
		
		-- Book 9
		CREATE LASTCHILD OF OutputRoot.JSON.Data.Item AS refBook TYPE NameValue NAME 'Item';
		SET refBook.id = 9;
		SET refBook.title = 'The Da Vinci Code';
		SET refBook.isbn = '978-0307474278';
		SET refBook.author = 'Dan Brown';
		SET refBook.published = '2003-03-18';
		SET refBook.format = 'E-book';
		SET refBook.language = 'English';
		SET refBook.pages = 689;
		
		-- Book 10
		CREATE LASTCHILD OF OutputRoot.JSON.Data.Item AS refBook TYPE NameValue NAME 'Item';
		SET refBook.id = 10;
		SET refBook.title = 'Crime and Punishment';
		SET refBook.isbn = '978-0679783268';
		SET refBook.author = 'Fyodor Dostoevsky';
		SET refBook.published = '1866-01-01';
		SET refBook.format = 'Hardcover';
		SET refBook.language = 'Russian';
		SET refBook.pages = 671;

		RETURN TRUE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;

	CREATE PROCEDURE CopyEntireMessage() BEGIN
		SET OutputRoot = InputRoot;
	END;
END MODULE;
