		SET list.Item[4].isbn = '978-0141439518';
		SET list.Item[4].author = 'Jane Austen';
		SET list.Item[4].published = '1813-01-28';
		SET list.Item[4].format = 'Paperback';
		SET list.Item[4].language = 'English';
		SET list.Item[4].pages = 432;
		
		-- Book 5
		SET list.Item[5].id = 5;
		SET list.Item[5].title = 'The Catcher in the Rye';
		SET list.Item[5].isbn = '978-0316769488';
		SET list.Item[5].author = 'J.D. Salinger';
		SET list.Item[5].published = '1951-07-16';
		SET list.Item[5].format = 'Hardcover';
		SET list.Item[5].language = 'English';
		SET list.Item[5].pages = 234;
		
		-- Book 6
		SET list.Item[6].id = 6;
		SET list.Item[6].title = 'The Hobbit';
		SET list.Item[6].isbn = '978-0544003415';
		SET list.Item[6].author = 'J.R.R. Tolkien';
		SET list.Item[6].published = '1937-09-21';
		SET list.Item[6].format = 'Paperback';
		SET list.Item[6].language = 'English';
		SET list.Item[6].pages = 310;
		
		-- Book 7
		SET list.Item[7].id = 7;
		SET list.Item[7].title = 'The Fellowship of the Ring';
		SET list.Item[7].isbn = '978-0345339706';
		SET list.Item[7].author = 'J.R.R. Tolkien';
		SET list.Item[7].published = '1954-07-29';
		SET list.Item[7].format = 'Hardcover';
		SET list.Item[7].language = 'English';
